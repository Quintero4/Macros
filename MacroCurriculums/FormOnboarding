Private Sub checkCloseWB(ByVal wb As Workbook)
    If CheckBoxCloseFiles And Not wb Is Nothing Then
        wb.Close
    End If
End Sub
Private Sub ComboBoxCurriculum_Change()
    ' Deshabilitar elementos del formulario que no son necesario según el curriculum
    Select Case ComboBoxCurriculum.Value
        Case "EHS", "FOD", "No Show & Late cancellation", "Espacios confinados", "Formación de Mantas", "Crisis Management", "Safety Culture", "Aviation Safety", "OnBoarding Aviation Safety":
            CheckBoxSaveToFolder.Enabled = False
        Case Else:
            CheckBoxSaveToFolder.Enabled = True
    End Select
End Sub
