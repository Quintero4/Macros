Private Sub UserForm_Initialize()

    Me.Caption = "Seleccionar Archivos Excel"
    Me.Width = 400
    Me.Height = 190

    Me.StartUpPosition = 0
    On Error Resume Next
    Me.Left = Application.Left + (Application.Width - Me.Width) / 2
    Me.Top = Application.Top + (Application.Height - Me.Height) / 2
    On Error GoTo 0


    ComboBoxCurriculum.AddItem "Ejecutar todos los curriculums"
    ComboBoxCurriculum.AddItem "Health & Safety"
    ComboBoxCurriculum.AddItem "Export Control"
    ComboBoxCurriculum.AddItem "Assessment"
    ComboBoxCurriculum.AddItem "TCO"
    ComboBoxCurriculum.AddItem "POA"
    ComboBoxCurriculum.AddItem "EHS"
    ComboBoxCurriculum.AddItem "No Show & Late cancellation"
    ComboBoxCurriculum.AddItem "FOD"
    ComboBoxCurriculum.AddItem "Espacios confinados"
    ComboBoxCurriculum.AddItem "Formación de Mantas"
    ComboBoxCurriculum.AddItem "Crisis Management"
    ComboBoxCurriculum.AddItem "Safety Culture"
        'Insertado
    ComboBoxCurriculum.AddItem "Aviation Safety"
    ComboBoxCurriculum.AddItem "OnBoarding Aviation Safety"
End Sub
