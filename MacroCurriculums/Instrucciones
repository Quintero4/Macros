'==============================================================================
' B) FUNCION NUEVA (pegar en Auxfunctions, junto a analizeFileCU_HS)
'==============================================================================

' Nombres exactos de los curriculums en la hoja de Curriculum_Details
' (celda de la columna A que precede a cada tabla). VERIFICAR.
Private Const CU_QES_TL = "CU-ADS-M-ALL-Quality Essentials for Team Leaders"
Private Const CU_QES_SC = "CU-ADS-M-ALL-Quality Essentials for SteerCo"

Public Function analizeFileCU_QES() As Workbook

    Dim importFilePath, fileName As String
    Dim exportWB As Workbook
    Dim curriculums, siglumDictionary As Dictionary

    'Hojas a separar
    Set curriculums = New Dictionary
    curriculums.Add CU_QES_TL, "Reporte TL"
    curriculums.Add CU_QES_SC, "Reporte SteerCo"

    'Fichero Curriculum_Details (el mas reciente de la carpeta de la fila de Ejecutar)
    importFilePath = getFilePath(NAME_QES, fileFilter:="Curriculum_Details*.xls*")

    Application.ScreenUpdating = False
    Application.DisplayAlerts = False

    If importFilePath <> "Falso" Then

        Set exportWB = Workbooks.Open(fileName:=importFilePath, ReadOnly:=False)

        exportWB.Sheets(1).Activate

        Set siglumDictionary = getSiglumDictionary()

        Call removeExtraRows

        Call removeColumns(curriculum:=NAME_QES)

        Call insertColumn(name:="Siglum", position:=4)

        Call fillSiglumColumn(siglumDictionary, column:=4)

        Call splitCurriculums(curriculums)

        Call removeInactiveUsers(exportWB, "Employee ID")

        Call colorInactiveUsers(exportWB, "Employee ID")

        Call autofitColumns

        Call formatTable

        'Cursos de 2 en 2 columnas (Status / Completion date), desde la columna 7
        Call groupCourses(exportWB.Sheets("Reporte TL"), startColumn:=7, endColumn:=0)
        Call groupCourses(exportWB.Sheets("Reporte SteerCo"), startColumn:=7, endColumn:=0)

        'Rellena estados vacios/caducados desde "My team Quality essential.xlsx"
        Call fillEmptyStatus(checkAllLearningFile:=True, _
                             learningKey:="My Team Quality Essentials", _
                             learningFilter:="My team Quality essential*.xls*")

        Application.Wait Now + TimeValue("00:00:02")

        Call applyColorRules

        Application.Wait Now + TimeValue("00:00:02")

        Call colorExpiredDates

        Call checkCurriculumCompletion

        Call checkCoursesCompletion(exportWB.Sheets("Reporte TL"), startColumn:=7, endColumn:=-1)
        Call checkCoursesCompletion(exportWB.Sheets("Reporte SteerCo"), startColumn:=7, endColumn:=-1)

        'Resumen: createSummary genera los 2 primeros cuadros (filas 2 y 10)
        Call createSummary(curriculums, exportWB)

        'Igual que en Health & Safety: cuadros 3 y 4 (filas 18 y 26) excluyendo Bajas/Desplazados.
        'Si solo se quieren 2 cuadros en total, borrar estas 4 lineas.
        Call createSummaryTable(18, exportWB.Sheets("Resumen"), exportWB.Sheets("Reporte TL"), CU_QES_TL)
        Call createSummaryTable(26, exportWB.Sheets("Resumen"), exportWB.Sheets("Reporte SteerCo"), CU_QES_SC)

        Call excludeInvisibleFromSummaryTable(exportWB, "Reporte TL", 18)
        Call excludeInvisibleFromSummaryTable(exportWB, "Reporte SteerCo", 26)

        fileName = "TAOA QES CU " & Application.WorksheetFunction.Text(Date, "mmm.dd.yyyy") & ".xlsx"

        Call exportWorkbook(exportWB, NAME_QES, fileName)

    End If

    Set analizeFileCU_QES = exportWB

End Function


