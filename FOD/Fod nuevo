Private Function CleanStatus(ByVal s As Variant) As String
    If IsError(s) Then
        CleanStatus = ""
    ElseIf IsEmpty(s) Or IsNull(s) Then
        CleanStatus = ""
    Else
        CleanStatus = UCase$(Trim$(CStr(s)))
    End If
End Function

' Devuelve el texto de una celda/variante sin espacios (incluye espacios no separables)
' y sin fallar si la celda contiene un error (#N/D, #REF!, etc.).
Private Function TextoSeguro(ByVal v As Variant) As String
    If IsError(v) Then Exit Function
    If IsEmpty(v) Then Exit Function
    If IsNull(v) Then Exit Function
    TextoSeguro = Trim$(Replace(CStr(v), Chr$(160), " "))
End Function

' Convierte una cadena formada solo por dígitos en Long. Devuelve -1 si no lo es.
Private Function NumeroSeguro(ByVal txt As String) As Long
    txt = Trim$(txt)
    If Len(txt) = 0 Or Len(txt) > 9 Then
        NumeroSeguro = -1
        Exit Function
    End If
    If txt Like "*[!0-9]*" Then
        NumeroSeguro = -1
        Exit Function
    End If
    NumeroSeguro = CLng(txt)
End Function

' Mes en número (1-12) o en texto (ene/jan, feb, mar, abr/apr, ...). Devuelve -1 si no se reconoce.
Private Function MesDesdeTexto(ByVal txt As String) As Long
    txt = Trim$(txt)
    If Len(txt) = 0 Then
        MesDesdeTexto = -1
        Exit Function
    End If

    If txt Like "*[!0-9]*" Then
        Select Case LCase$(Left$(txt, 3))
            Case "ene", "jan": MesDesdeTexto = 1
            Case "feb": MesDesdeTexto = 2
            Case "mar": MesDesdeTexto = 3
            Case "abr", "apr": MesDesdeTexto = 4
            Case "may": MesDesdeTexto = 5
            Case "jun": MesDesdeTexto = 6
            Case "jul": MesDesdeTexto = 7
            Case "ago", "aug": MesDesdeTexto = 8
            Case "sep", "set": MesDesdeTexto = 9
            Case "oct": MesDesdeTexto = 10
            Case "nov": MesDesdeTexto = 11
            Case "dic", "dec": MesDesdeTexto = 12
            Case Else: MesDesdeTexto = -1
        End Select
    Else
        MesDesdeTexto = NumeroSeguro(txt)
    End If
End Function

Private Function EsSerialValido(ByVal n As Double) As Boolean
    EsSerialValido = (n >= 1 And n <= 2958465)   ' 01/01/1900 a 31/12/9999
End Function

' Convierte cualquier valor (fecha real, número de serie o texto) en fecha sin depender
' de la configuración regional. Devuelve Empty si no es una fecha válida.
' Textos: dd/mm/yyyy, dd-mm-yyyy, dd.mm.yyyy, yyyy-mm-dd, dd-mmm-yyyy, con o sin hora.
' Si el segundo número es > 12 y el primero <= 12 se interpreta como mm/dd/yyyy (sin ambigüedad).
' Si es ambiguo (ej. 03/04/2024) se asume SIEMPRE día/mes/año.
Private Function ParseFechaSinLocale(ByVal valor As Variant) As Variant
    Dim s As String
    Dim posEspacio As Long
    Dim partes() As String
    Dim p0 As String, p1 As String, p2 As String
    Dim d As Long, m As Long, y As Long, tmp As Long
    Dim resultado As Date

    ParseFechaSinLocale = Empty

    If IsError(valor) Then Exit Function
    If IsEmpty(valor) Then Exit Function
    If IsNull(valor) Then Exit Function

    Select Case VarType(valor)
        Case vbDate
            ParseFechaSinLocale = CDate(valor)
            Exit Function
        Case vbDouble, vbInteger, vbLong, vbSingle, vbCurrency
            If EsSerialValido(CDbl(valor)) Then ParseFechaSinLocale = CDate(CDbl(valor))
            Exit Function
    End Select

    s = TextoSeguro(valor)
    If Len(s) = 0 Then Exit Function

    ' Formato ISO con "T" (2024-05-12T10:30:00)
    If Len(s) > 10 Then
        If Mid$(s, 11, 1) = "T" Then s = Left$(s, 10)
    End If

    ' Quitar la parte horaria ("12/05/2024 10:30")
    posEspacio = InStr(s, " ")
    If posEspacio > 0 Then
        If InStr(posEspacio, s, ":") > 0 Then s = Trim$(Left$(s, posEspacio - 1))
    End If

    ' Texto que es solo un número entero: número de serie de Excel
    If InStr(s, "/") = 0 And InStr(s, "-") = 0 And InStr(s, ".") = 0 _
       And InStr(s, ",") = 0 And InStr(s, " ") = 0 Then
        tmp = NumeroSeguro(s)
        If tmp >= 1 Then
            If EsSerialValido(tmp) Then ParseFechaSinLocale = CDate(tmp)
        End If
        Exit Function
    End If

    s = Replace(s, ".", "/")
    s = Replace(s, "-", "/")
    s = Replace(s, " ", "/")
    partes = Split(s, "/")
    If UBound(partes) <> 2 Then Exit Function

    p0 = Trim$(partes(0))
    p1 = Trim$(partes(1))
    p2 = Trim$(partes(2))

    If Len(p0) = 4 And NumeroSeguro(p0) >= 0 Then
        ' yyyy/mm/dd
        y = NumeroSeguro(p0)
        m = MesDesdeTexto(p1)
        d = NumeroSeguro(p2)
    Else
        ' dd/mm/yyyy
        d = NumeroSeguro(p0)
        m = MesDesdeTexto(p1)
        y = NumeroSeguro(p2)
        If m > 12 And d >= 1 And d <= 12 Then
            tmp = d
            d = m
            m = tmp
        End If
        If y >= 0 And y < 100 Then y = y + 2000
    End If

    If y < 1900 Or y > 9999 Or m < 1 Or m > 12 Or d < 1 Or d > 31 Then Exit Function

    resultado = DateSerial(y, m, d)
    If Day(resultado) <> d Or Month(resultado) <> m Then Exit Function   ' ej. 31/04

    ParseFechaSinLocale = resultado
End Function

' Fecha del curso: primero fecha de finalización (K), si no la de registro (J), si no la otra (H).
Private Function FechaDelCurso(ByVal fFin As Variant, ByVal fRegistro As Variant, ByVal fOtra As Variant) As Variant
    Dim f As Variant

    FechaDelCurso = Empty

    f = ParseFechaSinLocale(fFin)
    If IsDate(f) Then
        FechaDelCurso = DateSerial(Year(f), Month(f), Day(f))
        Exit Function
    End If

    f = ParseFechaSinLocale(fRegistro)
    If IsDate(f) Then
        FechaDelCurso = DateSerial(Year(f), Month(f), Day(f))
        Exit Function
    End If

    f = ParseFechaSinLocale(fOtra)
    If IsDate(f) Then
        FechaDelCurso = DateSerial(Year(f), Month(f), Day(f))
    End If
End Function

Private Function EstaCaducado(ByVal fecha As Variant, ByVal hoy As Date) As Boolean
    EstaCaducado = (DateAdd("yyyy", ANIOS_CADUCIDAD, CDate(fecha)) <= hoy)
End Function

' Estado normalizado ("" si no es uno de los estados válidos)
Private Function EstadoCanonico(ByVal v As Variant) As String
    Select Case CleanStatus(v)
        Case "COMPLETED": EstadoCanonico = "Completed"
        Case "REGISTERED": EstadoCanonico = "Registered"
        Case "EXEMPT": EstadoCanonico = "Exempt"
        Case "COMPLETED (EQUIVALENT)": EstadoCanonico = "Completed (Equivalent)"
        Case Else: EstadoCanonico = ""
    End Select
End Function

Private Function PrioridadEstado(ByVal estado As String) As Long
    Select Case estado
        Case "Completed": PrioridadEstado = 4
        Case "Completed (Equivalent)": PrioridadEstado = 3
        Case "Exempt": PrioridadEstado = 2
        Case "Registered": PrioridadEstado = 1
        Case Else: PrioridadEstado = 0
    End Select
End Function

' Decide si un registro nuevo debe sustituir al que ya está guardado:
'  - Si no hay nada guardado, se guarda.
'  - Si el nuevo no tiene fecha, nunca sustituye a algo ya guardado.
'  - Si el guardado no tiene fecha, lo sustituye cualquier registro con fecha.
'  - Gana la fecha más reciente; en caso de empate, gana el estado de mayor prioridad.
Private Function DebeReemplazar(ByVal estadoNuevo As String, ByVal fechaNueva As Variant, _
                                ByVal estadoActual As String, ByVal fechaActual As Variant) As Boolean
    If Len(estadoActual) = 0 Then
        DebeReemplazar = True
    ElseIf Not IsDate(fechaNueva) Then
        DebeReemplazar = False
    ElseIf Not IsDate(fechaActual) Then
        DebeReemplazar = True
    ElseIf CDate(fechaNueva) > CDate(fechaActual) Then
        DebeReemplazar = True
    ElseIf CDate(fechaNueva) = CDate(fechaActual) Then
        DebeReemplazar = (PrioridadEstado(estadoNuevo) > PrioridadEstado(estadoActual))
    Else
        DebeReemplazar = False
    End If
End Function

Private Function ColorEstado(ByVal estado As String) As Long
    Select Case estado
        Case "Completed", "Completed (Equivalent)", "Exempt"
            ColorEstado = RGB(0, 128, 0)
        Case "Registered"
            ColorEstado = RGB(0, 0, 255)
        Case ESTADO_CADUCADO
            ColorEstado = RGB(255, 165, 0)
        Case Else
            ColorEstado = RGB(255, 0, 0)
    End Select
End Function

Private Function EsSi(ByVal v As Variant) As Boolean
    Dim t As String
    t = UCase$(TextoSeguro(v))
    EsSi = (t = "SI" Or t = "S" & ChrW(205))
End Function

Private Function ExtraerSiglum(ByVal v As Variant) As String
    Dim partes() As String
    partes = Split(TextoSeguro(v), " \ ")
    If UBound(partes) >= 1 Then ExtraerSiglum = Trim$(partes(1))
End Function

Private Function CrearDiccionarioTexto() As Object
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    d.CompareMode = vbTextCompare   ' sin distinguir mayúsculas/minúsculas (debe fijarse con el diccionario vacío)
    Set CrearDiccionarioTexto = d
End Function

Private Function EstaEnConjunto(ByVal nombre As String, ByVal conjunto As Object) As Boolean
    If Len(nombre) = 0 Then
        EstaEnConjunto = False
    Else
        EstaEnConjunto = conjunto.Exists(nombre)
    End If
End Function

Private Function ExisteHoja(ByVal wb As Workbook, ByVal nombre As String) As Boolean
    Dim ws As Object
    On Error Resume Next
    Set ws = wb.Sheets(nombre)
    ExisteHoja = Not (ws Is Nothing)
    On Error GoTo 0
End Function

Private Function ObtenerLibroAbierto(ByVal nombre As String) As Workbook
    Dim wb As Workbook
    For Each wb In Workbooks
        If StrComp(wb.Name, nombre, vbTextCompare) = 0 Then
            Set ObtenerLibroAbierto = wb
            Exit Function
        End If
    Next wb
End Function

