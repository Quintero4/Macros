Option Explicit

Private Function CleanStatus(ByVal s As Variant) As String
    If IsError(s) Or IsEmpty(s) Then
        CleanStatus = ""
    Else
        CleanStatus = UCase$(Trim$(CStr(s)))
    End If
End Function

Private Function ParseFechaSinLocale(ByVal valor As Variant) As Variant
    Dim s As String
    Dim partes() As String
    Dim d As Integer, m As Integer, y As Integer

    ' Fecha real de Excel: si el día es <= 12, el origen la guarda con día y mes intercambiados
    ' (interpretación americana), así que se vuelven a intercambiar.
    Select Case VarType(valor)
        Case vbDate
            If Day(valor) <= 12 Then
                ParseFechaSinLocale = DateSerial(Year(valor), Day(valor), Month(valor))
            Else
                ParseFechaSinLocale = valor
            End If
            Exit Function
        Case vbDouble, vbInteger, vbLong, vbSingle, vbCurrency
            ParseFechaSinLocale = valor
            Exit Function
    End Select

    If IsEmpty(valor) Or IsNull(valor) Then
        ParseFechaSinLocale = ""
        Exit Function
    End If

    s = Trim$(CStr(valor))
    If s = "" Then
        ParseFechaSinLocale = ""
        Exit Function
    End If

    If InStr(s, "/") = 0 And InStr(s, "-") = 0 Then
        If IsNumeric(s) Then
            ParseFechaSinLocale = CDbl(s)
        Else
            ParseFechaSinLocale = ""
        End If
        Exit Function
    End If

    If InStr(s, "/") > 0 Then
        partes = Split(s, "/")
    Else
        partes = Split(s, "-")
    End If

    If UBound(partes) <> 2 Then
        ParseFechaSinLocale = ""
        Exit Function
    End If

    On Error GoTo ErrorParseo
    d = CInt(Trim$(partes(0)))
    m = CInt(Trim$(partes(1)))
    y = CInt(Trim$(partes(2)))
    On Error GoTo 0

    If y < 100 Then y = y + 2000

    If d >= 1 And d <= 31 And m >= 1 And m <= 12 And y > 0 Then
        ParseFechaSinLocale = DateSerial(y, m, d)
    Else
        ParseFechaSinLocale = ""
    End If
    Exit Function

ErrorParseo:
    ParseFechaSinLocale = ""
End Function



Sub Main()
    Call GenerarInformeFOD
End Sub

Sub GenerarInformeFOD(Optional ByVal rutaCarpetaWbFicheroFuenteFOD As String)

    ' Declaración de variables
    Dim libreriaModulos As Workbook
    Dim wbData As Workbook
    Dim wbMacroCurriculum As Workbook
    Dim wb As Workbook
    Dim wsData As Worksheet
    Dim wsReport As Worksheet
    Dim wsUsuariosInactivos As Worksheet
    Dim rng As Range
    Dim cell As Range
    Dim lastRow As Long
    Dim reportRow As Long
    Dim i As Long
    Dim fila As Long
    Dim filas As Long
    Dim courseList As Object
    Dim fodInitialTrainingCourses As Object
    Dim courseName As String
    Dim status As String
    Dim completionDate As Variant
    Dim registrationDate As Variant
    Dim otherDate As Variant
    Dim cursoFecha As Variant
    Dim currentDate As Date
    Dim personID As String
    Dim colOffset As Integer
    Dim personas As Object
    Dim personaKey As Variant
    Dim personaData As Object
    Dim totalRegistros As Long
    Dim registrosConID As Long
    Dim registrosConEstadoValido As Long
    Dim registrosIncluidos As Long
    Dim myTeamAllLearningFileFullPath As String
    Dim myTeamAllLearningFileFullName As String
    Dim variableWithoutValueOnlyForUseApplicationFunctions As Variant
    Dim valorColumnaR As String
    Dim lastRowUsuariosInactivos As Long
    Dim usuariosInactivos As Object
    Dim valorColumnaInvisible As String
    Dim valorColumnaIdUsuario As String
    Dim valorInvisible As String
    Dim ID As Long
    Dim fullPathWbMacroCurriculum As String
    Dim isMacroEjecutadaDesdeMacroCurriculums As Boolean
    Dim informeWB As Workbook
    Dim resumenFODWS As Worksheet
    Dim nombreInforme As String
    Dim extensionInforme As String
    Dim rutaInformes As String
    Dim rutaFinal As String
    Dim numeroArchivoConMismoNombre As Integer

    ' Desactivar actualizaciones para mejorar el rendimiento
    Application.ScreenUpdating = False
    Application.Calculation = xlCalculationManual
    Application.EnableEvents = False

    On Error GoTo SafeExit

    ' Inicializar la fecha actual
    currentDate = Date

    '-----------------------------------------------------------------------------------
    ' CARGAR LIBRERÍA DE MÓDULOS
    '-----------------------------------------------------------------------------------
    On Error Resume Next
    Set libreriaModulos = Workbooks.Open("\\Spi60001.eadscasa.casa.corp\a400m san pablo\Lean_Manufacturing\10.- PCM\28. PCM\Development enviroment\LibreriaModulos\LibreriaModulosConFuncionesReutilizables.xlsm")
    On Error GoTo SafeExit

    '-----------------------------------------------------------------------------------
    ' OBTENER Y ABRIR EL ARCHIVO DE DATOS "My Team All Learning"
    '-----------------------------------------------------------------------------------
    If rutaCarpetaWbFicheroFuenteFOD = "" Then
        rutaCarpetaWbFicheroFuenteFOD = "\\Spi60001.eadscasa.casa.corp\a400m san pablo\Lean_Manufacturing\10.- PCM\28. PCM\1.1.7 Macro Unificar All Learning\Output\"
        isMacroEjecutadaDesdeMacroCurriculums = False
    Else
        isMacroEjecutadaDesdeMacroCurriculums = True
    End If

    myTeamAllLearningFileFullPath = Application.Run("'LibreriaModulosConFuncionesReutilizables.xlsm'!GetMostRecentAbsolutePathFileInAFolder", _
        "My Team All Learning_", _
        rutaCarpetaWbFicheroFuenteFOD)

    If myTeamAllLearningFileFullPath = "" Then
        MsgBox "No se encontró el archivo 'My Team All Learning'.", vbCritical
        GoTo SafeExit
    End If

    myTeamAllLearningFileFullName = Application.Run("'LibreriaModulosConFuncionesReutilizables.xlsm'!GetFullFileNameFromFullPath", myTeamAllLearningFileFullPath)
    variableWithoutValueOnlyForUseApplicationFunctions = Application.Run("'LibreriaModulosConFuncionesReutilizables.xlsm'!CloseExcelWorkbook", myTeamAllLearningFileFullName)
    Set wbData = Application.Run("'LibreriaModulosConFuncionesReutilizables.xlsm'!OpenExcelWorkbook", myTeamAllLearningFileFullPath)
    Set wsData = wbData.Sheets("My Team All Learning")

    If wsData.AutoFilterMode Then wsData.AutoFilterMode = False

    '-----------------------------------------------------------------------------------
    ' CARGAR LA LISTA DE CURSOS FOD CONSIDERADOS INICIALES EN LA HOJA CONFIGURACIÓN
    '-----------------------------------------------------------------------------------
    Set fodInitialTrainingCourses = CreateObject("Scripting.Dictionary")

    With ThisWorkbook.Sheets("Configuración")
        For fila = 2 To .Cells(.Rows.Count, "A").End(xlUp).Row
            If Len(Trim$(CStr(.Cells(fila, "A").Value))) > 0 Then
                fodInitialTrainingCourses.Add CStr(fila), CStr(.Cells(fila, "A").Value)
            End If
        Next fila
    End With

    '-----------------------------------------------------------------------------------
    ' EXTRAER LOS NOMBRES DE CURSOS FOD ACTUALIZADOS
    '-----------------------------------------------------------------------------------
    Set courseList = CreateObject("Scripting.Dictionary")
    Set rng = wsData.Range("E1:E" & wsData.Cells(wsData.Rows.Count, "E").End(xlUp).Row)

    ID = 0
    For Each cell In rng
        If InStr(1, CStr(cell.Value), "FOD", vbTextCompare) > 0 Then
            ID = ID + 1
            courseList.Add CStr(ID), CStr(cell.Value)
        End If
    Next cell

    '-----------------------------------------------------------------------------------
    ' CARGAR USUARIOS_INACTIVOS DE LA MACRO CURRICULUMS
    '-----------------------------------------------------------------------------------
    Set usuariosInactivos = CreateObject("Scripting.Dictionary")
    fullPathWbMacroCurriculum = "\\Spi60001.eadscasa.casa.corp\a400m san pablo\Lean_Manufacturing\10.- PCM\28. PCM\1.1.3 Macro Curriculums\Macro Curriculums.xlsm"

    For Each wb In Workbooks
        If wb.Name = "Macro Curriculums.xlsm" Then
            Set wbMacroCurriculum = wb
            Exit For
        End If
    Next wb
    If wbMacroCurriculum Is Nothing Then
        Set wbMacroCurriculum = Workbooks.Open(fullPathWbMacroCurriculum)
    End If

    Set wsUsuariosInactivos = wbMacroCurriculum.Sheets("Usuarios_Inactivos")

    With wsUsuariosInactivos
        lastRowUsuariosInactivos = .Cells(.Rows.Count, "B").End(xlUp).Row
        For filas = 2 To lastRowUsuariosInactivos
            valorColumnaIdUsuario = Trim$(CStr(.Cells(filas, "C").Value))
            valorColumnaInvisible = Trim$(CStr(.Cells(filas, "D").Value))
            If Len(valorColumnaIdUsuario) > 0 Then
                If Not usuariosInactivos.Exists(valorColumnaIdUsuario) Then
                    usuariosInactivos.Add valorColumnaIdUsuario, valorColumnaInvisible
                End If
            End If
        Next filas
    End With

    '-----------------------------------------------------------------------------------
    ' RECOPILAR Y PROCESAR LOS DATOS DE MY TEAM ALL LEARNING
    '-----------------------------------------------------------------------------------
    valorInvisible = ""
    lastRow = wsData.Cells(wsData.Rows.Count, "A").End(xlUp).Row

    Set personas = CreateObject("Scripting.Dictionary")
    totalRegistros = lastRow - 1
    registrosConID = 0
    registrosConEstadoValido = 0
    registrosIncluidos = 0

    For i = 2 To lastRow

        valorColumnaR = Trim$(CStr(wsData.Cells(i, "R").Value))

        If InStr(1, valorColumnaR, "TAOA", vbTextCompare) = 0 Then
            GoTo NextIteration
        End If

        personID = Trim$(CStr(wsData.Cells(i, "S").Value))

        If personID = "" Then
            GoTo NextIteration
        Else
            If usuariosInactivos.Exists(personID) Then
                valorInvisible = usuariosInactivos(personID)
                If UCase$(valorInvisible) = "SI" Then GoTo NextIteration
            End If
            registrosConID = registrosConID + 1
        End If

        personaKey = personID

        status = Trim$(CStr(wsData.Cells(i, "F").Value))

        If status = "Registered" Or status = "Completed" Or status = "Exempt" Or status = "Completed (Equivalent)" Then
            registrosConEstadoValido = registrosConEstadoValido + 1

            If Not personas.Exists(personaKey) Then
                Set personaData = CreateObject("Scripting.Dictionary")

                personaData("Nombre") = wsData.Cells(i, "B").Value
                personaData("Apellidos") = wsData.Cells(i, "A").Value
                personaData("ID") = personID
                personaData("Manager") = wsData.Cells(i, "T").Value

                On Error Resume Next
                personaData("Siglum") = Split(CStr(wsData.Cells(i, "R").Value), " \ ")(1)
                If Err.Number <> 0 Then
                    Err.Clear
                    personaData("Siglum") = ""
                End If
                On Error GoTo SafeExit

                personaData("InitialFODStatus") = ""
                personaData("InitialFODFecha") = ""

                personaData("CursoRecienteNombre") = ""
                personaData("CursoRecienteEstado") = ""
                personaData("CursoRecienteFecha") = ""

                personas.Add personaKey, personaData
            Else
                Set personaData = personas(personaKey)
            End If

            courseName = CStr(wsData.Cells(i, "E").Value)

            completionDate = ParseFechaSinLocale(wsData.Cells(i, "K").Value)
            registrationDate = ParseFechaSinLocale(wsData.Cells(i, "J").Value)
            otherDate = ParseFechaSinLocale(wsData.Cells(i, "H").Value)


            If IsDate(completionDate) Then
                cursoFecha = Int(CDate(completionDate))
            ElseIf IsDate(registrationDate) Then
                cursoFecha = Int(CDate(registrationDate))
            ElseIf IsDate(otherDate) Then
                cursoFecha = Int(CDate(otherDate))
            Else
                cursoFecha = ""
            End If

            If IsInCourseList(courseName, fodInitialTrainingCourses) And status = "Completed" Then
                If IsDate(cursoFecha) Then
                    If IsDate(personaData("InitialFODFecha")) Then
                        If cursoFecha > personaData("InitialFODFecha") Then
                            personaData("InitialFODStatus") = status
                            personaData("InitialFODFecha") = cursoFecha
                        End If
                    Else
                        personaData("InitialFODStatus") = status
                        personaData("InitialFODFecha") = cursoFecha
                    End If
                    registrosIncluidos = registrosIncluidos + 1
                End If
            End If

            If IsInCourseList(courseName, courseList) Or IsInCourseList(courseName, fodInitialTrainingCourses) Then
                If IsDate(cursoFecha) Then
                    If IsDate(personaData("CursoRecienteFecha")) Then
                        If cursoFecha > personaData("CursoRecienteFecha") Then
                            personaData("CursoRecienteNombre") = wsData.Cells(i, "E").Value
                            personaData("CursoRecienteEstado") = status
                            personaData("CursoRecienteFecha") = cursoFecha
                        End If
                    Else
                        personaData("CursoRecienteNombre") = wsData.Cells(i, "E").Value
                        personaData("CursoRecienteEstado") = status
                        personaData("CursoRecienteFecha") = cursoFecha
                    End If
                End If
                registrosIncluidos = registrosIncluidos + 1
            End If
        End If
NextIteration:
    Next i

    If personas.Count = 0 Then
        MsgBox "No hay datos con estado 'Registered' o 'Completed' para generar el informe.", vbInformation
        GoTo SafeExit
    End If

    '-----------------------------------------------------------------------------------
    ' LLENAR EL INFORME CON LOS DATOS PROCESADOS HOJA "Informe FOD"
    '-----------------------------------------------------------------------------------
    Set wsReport = ThisWorkbook.Sheets("Informe FOD")

    wsReport.Range("A3:Z1000").ClearContents
    wsReport.Range("A3:Z1000").Interior.Color = RGB(255, 255, 255)
    wsReport.Range("A3:Z1000").Font.Color = RGB(0, 0, 0)

    reportRow = 3
    colOffset = 6

    Dim InitialFODStatus As String
    Dim InitialFODFecha As Variant
    Dim CursoRecienteEstado As String
    Dim CursoRecienteFecha As Variant

    For Each personaKey In personas.Keys
        Set personaData = personas(personaKey)

        With wsReport
            .Cells(reportRow, "A").Value = personaData("Apellidos")
            .Cells(reportRow, "B").Value = personaData("Nombre")
            .Cells(reportRow, "C").Value = personaData("ID")

            If usuariosInactivos.Exists(personaData("ID")) Then
                valorInvisible = usuariosInactivos(personaData("ID"))
                If UCase$(valorInvisible) = "NO" Then
                    .Cells(reportRow, "A").Font.Color = RGB(255, 0, 0)
                    .Cells(reportRow, "B").Font.Color = RGB(255, 0, 0)
                End If
            End If

            .Cells(reportRow, "D").Value = personaData("Siglum")
            .Cells(reportRow, "E").Value = personaData("Manager")

            '---------------------- Initial FOD ----------------------
            InitialFODStatus = CStr(personaData("InitialFODStatus"))
            InitialFODFecha = personaData("InitialFODFecha")

            If IsDate(InitialFODFecha) Then
                If InitialFODStatus = "Completed" Then
                    If DateDiff("d", InitialFODFecha, currentDate) >= 730 Then
                        InitialFODStatus = "Completed (Caducado)"
                    End If
                End If
            End If

            If InitialFODStatus = "" Then
                .Cells(reportRow, colOffset).Value = "Pending"
                .Cells(reportRow, colOffset).Font.Color = RGB(255, 0, 0)
            Else
                .Cells(reportRow, colOffset).Value = InitialFODStatus
            End If

            .Cells(reportRow, colOffset + 1).Value = InitialFODFecha
            If IsDate(InitialFODFecha) Then
                .Cells(reportRow, colOffset + 1).NumberFormat = "Short Date"
                .Cells(reportRow, colOffset + 1).NumberFormat = "dd/mm/yyyy"
            End If

            Dim stInitial As String
            stInitial = CleanStatus(InitialFODStatus)

            Select Case stInitial
                Case "COMPLETED"
                    .Cells(reportRow, colOffset).Font.Color = RGB(0, 128, 0)
                Case "EXEMPT"
                    .Cells(reportRow, colOffset).Font.Color = RGB(0, 128, 0)
                Case "REGISTERED"
                    .Cells(reportRow, colOffset).Font.Color = RGB(0, 0, 255)
                Case "COMPLETED (CADUCADO)"
                    .Cells(reportRow, colOffset).Font.Color = RGB(255, 165, 0)
                    .Cells(reportRow, colOffset + 1).Font.Color = RGB(0, 0, 0)
                    .Cells(reportRow, colOffset + 1).Interior.Color = RGB(255, 0, 0)
                Case Else
                    .Cells(reportRow, colOffset).Font.Color = RGB(255, 0, 0)
            End Select

            '---------------------- Curso más reciente ----------------------
            CursoRecienteEstado = CStr(personaData("CursoRecienteEstado"))
            CursoRecienteFecha = personaData("CursoRecienteFecha")

            If IsDate(CursoRecienteFecha) Then
                If CursoRecienteEstado = "Completed" Then
                    If DateDiff("d", CursoRecienteFecha, currentDate) >= 730 Then
                        CursoRecienteEstado = "Completed (Caducado)"
                    Else
                        CursoRecienteEstado = "Completed"
                    End If
                End If
            End If

            If CursoRecienteEstado = "" Then
                .Cells(reportRow, colOffset + 2).Value = "Pending"
                .Cells(reportRow, colOffset + 2).Font.Color = RGB(255, 0, 0)
            Else
                .Cells(reportRow, colOffset + 2).Value = CursoRecienteEstado
                If CursoRecienteEstado = "Completed (Equivalent)" Then
                .Cells(reportRow, colOffset + 2).Value = "Completed"
                End If
            End If

            .Cells(reportRow, colOffset + 3).Value = CursoRecienteFecha
            .Cells(reportRow, colOffset + 4).Value = personaData("CursoRecienteNombre")
            If IsDate(CursoRecienteFecha) Then
                .Cells(reportRow, colOffset + 3).NumberFormat = "Short Date"
                .Cells(reportRow, colOffset + 3).NumberFormat = "dd/mm/yyyy"
            End If

            Dim stReciente As String
            stReciente = CleanStatus(CursoRecienteEstado)

            Select Case stReciente
                Case "COMPLETED"
                    .Cells(reportRow, colOffset + 2).Font.Color = RGB(0, 128, 0)
                    If UCase$(Trim$(CStr(.Cells(reportRow, colOffset + 2).Value))) = "COMPLETED" _
                       And UCase$(Trim$(CStr(.Cells(reportRow, colOffset).Value))) = "COMPLETED (CADUCADO)" Then
                        .Cells(reportRow, colOffset).Value = "Completed"
                        .Cells(reportRow, colOffset).Font.Color = RGB(0, 128, 0)
                    End If
                    
                Case "COMPLETED (EQUIVALENT)"
                    .Cells(reportRow, colOffset + 2).Font.Color = RGB(0, 128, 0)
                    If UCase$(Trim$(CStr(.Cells(reportRow, colOffset + 2).Value))) = "COMPLETED" _
                       And UCase$(Trim$(CStr(.Cells(reportRow, colOffset).Value))) = "COMPLETED (CADUCADO)" Then
                        .Cells(reportRow, colOffset).Value = "Completed"
                        .Cells(reportRow, colOffset).Font.Color = RGB(0, 128, 0)
                    End If

                Case "REGISTERED"
                    .Cells(reportRow, colOffset + 2).Font.Color = RGB(0, 0, 255)

                Case "COMPLETED (CADUCADO)"
                    .Cells(reportRow, colOffset + 2).Font.Color = RGB(255, 165, 0)
                    .Cells(reportRow, colOffset + 3).Font.Color = RGB(0, 0, 0)
                    .Cells(reportRow, colOffset + 3).Interior.Color = RGB(255, 0, 0)

                Case "EXEMPT"
                    .Cells(reportRow, colOffset + 2).Font.Color = RGB(0, 128, 0)

                    If UCase$(Trim$(CStr(.Cells(reportRow, colOffset + 2).Value))) = "EXEMPT" _
                       And UCase$(Trim$(CStr(.Cells(reportRow, colOffset).Value))) = "COMPLETED (CADUCADO)" Then
                        .Cells(reportRow, colOffset).Value = "Completed"
                        .Cells(reportRow, colOffset).Font.Color = RGB(0, 128, 0)
                    End If

                    If UCase$(Trim$(CStr(.Cells(reportRow, colOffset + 2).Value))) = "EXEMPT" _
                       And UCase$(Trim$(CStr(.Cells(reportRow, colOffset).Value))) = "PENDING" Then
                        .Cells(reportRow, colOffset).Value = "Completed"
                        .Cells(reportRow, colOffset).Font.Color = RGB(0, 128, 0)
                    End If

                Case Else
                    .Cells(reportRow, colOffset + 2).Font.Color = RGB(255, 0, 0)
            End Select
        End With

        reportRow = reportRow + 1
    Next personaKey

    '-----------------------------------------------
    'EXPORTAR HOJAS A UN NUEVO LIBRO PARA SEPARAR EL INFORME DE LA MACRO
    '-----------------------------------------------
    wsReport.Copy
    Set informeWB = ActiveWorkbook

    ThisWorkbook.Sheets("Resumen FOD").Copy Before:=informeWB.Sheets(1)
    Set resumenFODWS = informeWB.Sheets(1)

    '------------------------------------------------------------------------------------------------------------------------------------------------------------------
    'EXPORTAR INFORME TENIENDO EN CUENTA QUE PUEDAN EXISTIR YA DE UN MISMO DÍA
    '-----------------------------------------------------------------------------------------------------------------------------------------------------------------
    rutaInformes = ThisWorkbook.Path & "\Informes\"
    If Dir(rutaInformes, vbDirectory) = "" Then MkDir rutaInformes

    nombreInforme = "TAOA FOD " & Application.WorksheetFunction.Text(Date, "mmm.dd.yyyy")
    extensionInforme = ".xlsx"
    rutaFinal = rutaInformes & nombreInforme & extensionInforme

    numeroArchivoConMismoNombre = 0
    Do While Dir(rutaFinal) <> ""
        numeroArchivoConMismoNombre = numeroArchivoConMismoNombre + 1
        rutaFinal = rutaInformes & nombreInforme & " (" & numeroArchivoConMismoNombre & ")" & extensionInforme
    Loop

    Application.DisplayAlerts = False
    informeWB.SaveAs Filename:=rutaFinal, FileFormat:=xlOpenXMLWorkbook
    Application.DisplayAlerts = True

    If Not libreriaModulos Is Nothing Then libreriaModulos.Close SaveChanges:=False
    If Not wbData Is Nothing Then wbData.Close SaveChanges:=False

    If isMacroEjecutadaDesdeMacroCurriculums Then
        ThisWorkbook.Close SaveChanges:=True
    Else
        If Not wbMacroCurriculum Is Nothing Then wbMacroCurriculum.Close SaveChanges:=False
        MsgBox "Ejecución finalizada e informe guardado en: " & rutaFinal, vbInformation
    End If

SafeExit:
    ' Restaurar configuraciones
    Application.ScreenUpdating = True
    Application.Calculation = xlCalculationAutomatic
    Application.EnableEvents = True
End Sub

'-----------------------------------------------------------------------------------
' FUNCIÓN: IsInCourseList
' DESCRIPCIÓN: Verifica si un curso está en la lista de cursos FOD (comparación exacta, case-sensitive del origen, diccionario con .Keys)
'-----------------------------------------------------------------------------------
Function IsInCourseList(courseName As String, courseList As Object) As Boolean
    Dim k As Variant
    For Each k In courseList.Keys
        If courseName = courseList(k) Then
            IsInCourseList = True
            Exit Function
        End If
    Next k
    IsInCourseList = False
End Function
