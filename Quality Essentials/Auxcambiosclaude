' Function which creates a dictionary of all the sigmlums and the count of the 'invisible' users (users with 'no' in the Invisible column of the Usuarios_Inactivos tab).
' These counts will be used in the Resumen tab to create the summary table excluding invisible users.
'   (key: Siglum, item: Count)
Private Function getSiglumInvisibleCountDictionary(ByVal ws As Worksheet, ByVal IDColumn As String, ByVal completed As Boolean) As Dictionary
    Dim siglumCountDictionary, invisibleUserDictionary As Dictionary
    Dim lastRow, userIDCol, curriculumCol, i, invisibleCol As Integer
    Dim curriculumStatus As String
    
    Set siglumCountDictionary = getEmptySiglumsDictionary()
    Set invisibleUserDictionary = getInvisibleUsersDictionary()
    
    With ws
        userIDCol = .Rows(2).Find(What:=IDColumn, LookIn:=xlValues, LookAt:=xlWhole).column
        curriculumCol = .Rows(2).Find(What:="Curriculum Status", LookIn:=xlValues, LookAt:=xlWhole).column
        lastRow = .Cells(.Rows.Count, 1).End(xlUp).row
        Dim siglum As String
            
        For i = lastRow To 2 Step -1
            If invisibleUserDictionary.Exists(CStr(.Cells(i, userIDCol).Value)) Then
                siglum = .Cells(i, userIDCol + 1).Value
                If completed = False Then
                    If siglum <> "" And siglumCountDictionary.Exists(siglum) Then
                        siglumCountDictionary(siglum) = siglumCountDictionary(siglum) + 1
                    Else
                        siglumCountDictionary("Not assigned") = siglumCountDictionary("Not assigned") + 1
                    End If
                Else
                    curriculumStatus = CStr(.Cells(i, curriculumCol).Value)
                    If curriculumStatus = "Completed" Or curriculumStatus = "Exempt" Or curriculumStatus = "Completed (Equivalent)" Or curriculumStatus = "Completed (Refresh)" Then
                        If siglum <> "" And siglumCountDictionary.Exists(siglum) Then
                            siglumCountDictionary(siglum) = siglumCountDictionary(siglum) + 1
                        Else
                            siglumCountDictionary("Not assigned") = siglumCountDictionary("Not assigned") + 1
                        End If
                    End If
                End If
            End If
        Next i
    End With
    
    Set getSiglumInvisibleCountDictionary = siglumCountDictionary
End Function

