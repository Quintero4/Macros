Private Function getSiglumList(ByVal ws As Worksheet, ByRef lastRow As Integer) As Dictionary
    Dim i As Integer
    Dim position As Integer
    Dim Auxdictionary As Dictionary
    Set Auxdictionary = New Dictionary

    lastRow = ws.Cells(Rows.Count, 1).End(xlUp).row

    position = 4 ' Columna de la tabla resumen donde se muestra cada siglum
    For i = 3 To lastRow
        Dim siglum As String
        siglum = ws.Cells(i, 4).Value

        ' Verificar si el siglum tiene más de 5 letras (para evitar que cuente TAOAIC)
        If Len(siglum) <= 5 And Not Auxdictionary.Exists(siglum) Then
            Auxdictionary.Add siglum, position
            position = position + 1
        End If
    Next i

    Set getSiglumList = Auxdictionary
End Function

Private Sub combineColumns(sh As Worksheet, c1 As Integer, c2 As Integer)
    Dim lastRow As Integer
    Dim i As Integer
    
    With sh
        ' Find the last row with data
        lastRow = .Cells(.Rows.Count, 1).End(xlUp).row
    
        ' Loop through each row and combine columns c1 and c2
        For i = 3 To lastRow
            If .Cells(i, c2).Value <> "" And .Cells(i, c1).Value = "" Then
                'Replace column c1 with c2
                .Cells(i, c1).Value = .Cells(i, c2).Value
            End If
        Next i
    
        ' Delete column
        .Columns(c2).Delete Shift:=xlToLeft
    End With
End Sub

Private Sub filterAndRemoveRows(ByVal column As String, ByVal filter As String, ByVal inclusive As Boolean)
    Dim lastRow As Long
    Dim filterColumn As Range

    ' Set the column range to filter
    Set filterColumn = Rows(2).Find(column, LookIn:=xlValues, LookAt:=xlWhole)

    ' Find the last row in the column
    lastRow = Cells(Rows.Count, filterColumn.column).End(xlUp).row
    
    If inclusive Then
        ' Apply the filter
        filterColumn.AutoFilter Field:=filterColumn.column, Criteria1:=filter
    Else
        ' Apply the inverse filter
        filterColumn.AutoFilter Field:=filterColumn.column, Criteria1:="<>" & filter & "*"
    End If

    ' Delete visible rows (excluding header)
    ActiveSheet.AutoFilter.Range.Offset(1, 0).Resize(lastRow - 1, 1).SpecialCells(xlCellTypeVisible).EntireRow.Delete
    ActiveSheet.ShowAllData

    ' Turn off the filter
    AutoFilterMode = False
End Sub

Private Sub filterArrayAndRemoveRows(ByVal column As String, ByVal filter As Variant)
    Dim lastRow, filterColumn, i, j As Long
    Dim userSiglum
    Dim removeRow As Boolean

    ' Set the column range to filter
    filterColumn = Rows(2).Find(column, LookIn:=xlValues, LookAt:=xlWhole).column

    ' Find the last row in the column
    lastRow = Cells(Rows.Count, filterColumn).End(xlUp).row

    i = 3
    Do While i <= lastRow
        userSiglum = Cells(i, filterColumn).Value
        removeRow = True
        For j = 0 To UBound(filter)
            If InStr(1, userSiglum, filter(j), vbTextCompare) Then
                removeRow = False
                Exit For
            End If
        Next j
        
        If removeRow Then
            Cells(i, filterColumn).EntireRow.Delete
            lastRow = lastRow - 1
        Else
            i = i + 1
        End If
    Loop
End Sub

