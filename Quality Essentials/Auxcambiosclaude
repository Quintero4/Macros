Public Function eliminarAcentosYSaltosDeLinea(ByVal cadenaAConvertir As String) As String

    cadenaAConvertir = Replace(cadenaAConvertir, "Á", "A")
    cadenaAConvertir = Replace(cadenaAConvertir, "É", "E")
    cadenaAConvertir = Replace(cadenaAConvertir, "Í", "I")
    cadenaAConvertir = Replace(cadenaAConvertir, "Ó", "O")
    cadenaAConvertir = Replace(cadenaAConvertir, "Ú", "U")
    cadenaAConvertir = Replace(cadenaAConvertir, Chr(10), "")
    eliminarAcentosYSaltosDeLinea = cadenaAConvertir
    
End Function

