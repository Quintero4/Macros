' Función que obtiene el fichero más reciente de una carpeta con un patrón de nombre específico
'   y lo pide al usuario si no encuentra coincidencias.
Public Function getFilePath(ByVal curriculum As String, ByVal fileFilter As String) As String
    Dim folderDictionary As Dictionary
    Dim importFilePath As String

    Set folderDictionary = mapFolders
    importFilePath = openMostRecentWorkbook(folderPath:=folderDictionary(curriculum)(0), fileFilter:=fileFilter)
    
    If importFilePath = "" Then
        importFilePath = getFilefromUser(curriculum)
    End If
    
    'Production
    getFilePath = importFilePath
    
    'Development
    'getFilePath = "\\Spi60001.eadscasa.casa.corp\a400m san pablo\Lean_Manufacturing\10.- PCM\28. PCM\Development enviroment\Macros\Curriculums\myTeamAllLearning\My Team All Learning_30_10_2024.xlsx"

End Function

' Función que pide un fichero al usuario mediante ventana emergente.
Private Function getFilefromUser(ByVal titleString As String) As String
    Dim selectedFile As Variant
    ' Mostrar el cuadro de diálogo "Abrir archivo"
    selectedFile = Application.GetOpenFilename(fileFilter:="Archivos Excel (*.xls; *.xlsx), *.xls; *.xlsx", Title:="Fichero " & titleString)
    getFilefromUser = selectedFile
End Function

' Método que elimina las primeras y últimas filas del documento activo.
Private Sub removeExtraRows()
    Dim lastDataRow, lastRow As Integer
    
    Rows("1:3").Delete
    
    lastDataRow = Cells(1, 1).End(xlDown).row
    lastRow = Cells(Rows.Count, 1).End(xlUp).row
    
    Rows(lastDataRow + 1 & ":" & lastRow).Delete
End Sub

' Método que elimina las columnas definidas según el curriculum
Private Sub removeColumns(ByVal curriculum As String)
    Select Case curriculum
        Case NAME_HS, NAME_QE, NAME_EC, NAME_POA, NAME_QES
            Call removeColumnByName("Hire Date")
            Call removeColumnByName("User Email")
            Call removeColumnByName("Registration Number")
            Call removeColumnByName("Curriculum Completion Totals (total number of items completed)")
        Case NAME_TR, NAME_DI
            Call removeColumnByName("Training - Training type")
            Call removeColumnByName("Training - Material type name")
            Call removeColumnByName("Training - Classroom session ID number")
            Call removeColumnByName("Training - Training starting date")
            Call removeColumnByName("Training record - Passed")
            Call removeColumnByName("Training record - Curriculum title (training record)")
            Call removeColumnByName("Training record - Curriculum version (training record)")
            Call removeColumnByName("Training - Training topic")
            Call removeColumnByName("Training - Training hours")
            Call removeColumnByName("Training - Training price")
            Call removeColumnByName("Training record - Last training record status change date")
            Call removeColumnByName("Training - Training end date")
        Case NAME_AS
            Call removeColumnByName("Employee's email")
            Call removeColumnByName("AWF")
            Call removeColumnByName("Division")
            Call removeColumnByName("Core Division")
            Call removeColumnByName("Company")
            Call removeColumnByName("Country")
            Call removeColumnByName("Location")
            Call removeColumnByName("Supervisory Organisation")
            Call removeColumnByName("Date last change of Job profile")
            Call removeColumnByName("Assessment initiation Date")
            Call removeColumnByName("Job Criticality")
            Call removeColumnByName("POA Job")
            Call removeColumnByName("MyHR/QA Scope")
            Call removeColumnByName("Job Profile")
        Case NAME_HS, NAME_QE, NAME_EC, NAME_TCO
            Call removeColumnByName("Hire Date")
            Call removeColumnByName("User Email")
            Call removeColumnByName("Registration Number")
            Call removeColumnByName("Curriculum Completion Totals (total number of items completed)")
    End Select
End Sub

' Método que elimina una columna por nombre en el documento activo.
Private Sub removeColumnByName(ByVal header As String)
    Dim rngHeader As Range
    
    Set rngHeader = Rows(2).Find(header, LookIn:=xlValues, LookAt:=xlWhole)
    
    If Not rngHeader Is Nothing Then
        Columns(rngHeader.column).Delete
    End If
End Sub

