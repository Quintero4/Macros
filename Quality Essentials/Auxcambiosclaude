Private Function checkAllLearningForMissingCourse(ByRef learningWB As Workbook, ByVal userID As String, ByVal course As String, _
                        lastRow, lastColumn, courseColumn, userIDColumn, trainingEndDateNumberColumn, trainingStartingDateNumberColumn, statusColumn, courseHeader)
    
    Dim filePath, newStatus, expireData, filteredFirstRowStatus, filteredFirstRowDate, filteredSecondRowStatus, filteredSecondRowDate, filteredRowLastTrainingRecordStatus As String
    Dim learningWS As Worksheet
    Dim filteredFirstRow, filteredSecondRow, filteredRow As Variant
    
    With learningWB.Sheets(1)
        
        .Cells.AutoFilter Field:=courseColumn, Criteria1:=course & "*"
        
         'If para depurar y encontrar un curso concreto de una persona, no es necesario comentar pero quizás aumente algo rendimiento si se comenta
        'If course = courseNameForTesting Then
            'trainingStartingDateNumberColumn = 7 'No aporta ningun valor esta linea, solo es para poder poner punto de ruptura dentro de la condición para cuando se cumpla
        'End If
        
        On Error Resume Next
        
        'Puede ser que todas las variables de filtered estén vacias al pasar por ellas
        'porque no hayan filas de información del curso en My Team All Learning,
        'para esa persona, esto puede ocurrir, no es que esté mal
              
        '-------------------------------------------------------------------------------------------------------------------------------------------------------
        'EXTRAEMOS EL NÚMERO DE LAS FILAS VISIBLES EN ORDEN PARA PODER EXTRAER LAS SIGUIENTES QUE NECESITEMOS :
        
        'OJO CON NO CONFUNDIRNOS, EL NÚMERO DE LA FILA ES LITERALMENTE QUE SI HAY UN FILTRO PUESTO Y LA (((PRIMERA)))) FILA QUE QUEREMOS
        'PONE QUE ESTÁ EN LA FILA 596, ES ESE NÚMERO DE FILA QUE USAREMOS PARA OBTENER SUS DATOS.
        
        'LUEGO USAREMOS EL NÚMERO DE LA PRIMERA FILA QUE QUERÍAMOS PARA BUSCAR LA SEGUNDA PERO SUMÁNDOLE 1 (filteredFirstRowNumber + 1)
        'Y ASÍ SUCESIVAMENTE.
        
        'PARA OBTENER UNA TERCERA FILA, USAMOS EL NÚMERO DE LA SEGUNDA FILA SUMANDOLE 1.
        
        'ASÍ CON TODAS
        '-------------------------------------------------------------------------------------------------------------------------------------------------------
        
        'Extaemos el número de las filas que nosotros definimos aquí que queremos analizar, aquí pueden ser 1, 2, 3 o las que sean según lo que necesitemos,
        'pero tendremos que añadir más abajo su procesamiento para extraer las filas que queremos (ACTUALMENTE EL CÓDIGO EXTRAE 2)
        
       '-----------Primera fila de información-------------------
       filteredFirstRowNumber = .Range(Cells(2, 1), Cells(lastRow, lastColumn)).SpecialCells(xlCellTypeVisible).row
        'Si la primera fila está vacia significa que no hay ninguna información, así que ponemos el valor de todas las filas que queríamos analizar como Empty
        If IsEmpty(filteredFirstRowNumber) Then
            filteredFirstRow = Empty
            filteredSecondRow = Empty
        Else
            
            'Si hay información en la primera fila, cojemos su status y su número de fila por si a futuro quisieramos analizar una segunda fila
            filteredFirstRow = .Range(Cells(filteredFirstRowNumber, 1), Cells(lastRow, lastColumn)).SpecialCells(xlCellTypeVisible).Value
            filteredFirstRowStatus = filteredFirstRow(1, statusColumn)
            
            '-----------Segunda fila de información-------------------
            filteredSecondRowNumber = .Range(Cells(filteredFirstRowNumber + 1, lastColumn), Cells(lastRow, lastColumn)).SpecialCells(xlCellTypeVisible).row
            'Comprobamos si el número de la segunda fila es 1, que sería la cabecera, lo que significa que no hay filas de información
            If filteredSecondRowNumber = 1 Then
                filteredSecondRow = Empty
            Else
             'Si hay información en la segunda fila, cojemos su status y su número de fila por si a futuro quisieramos analizar una tercera fila
                 filteredSecondRow = .Range(Cells(filteredSecondRowNumber, 1), Cells(lastRow, lastColumn)).SpecialCells(xlCellTypeVisible).Value
                 filteredSecondRowStatus = filteredSecondRow(1, statusColumn)
            End If
            '--------------------------------------------------------------
        End If
        '--------------------------------------------------------------
        
       
        
        
        
        '(RECORDATORIO DE QUE LOS DATOS ESTAN SACANDOSE DE <<<MY TEAM ALL LEARNING>>> EN ESTA FUNCIÓN)
        '---COMIENZA EL ANÁLISIS DE INFORMACIÓN DEL CURSO ACTUALMENTE ALMACENADO EN LA VARIABLE courseHeader
        'PARA DETERMINAR SU FECHA Y ESTADO DEFINITIVO ENTRE OTROS, PARA LA PERSONA------
        
        'AHORA MISMO ESTÁ FILTRADA LA HOJA DE MY TEAM ALL LEARNING CON EL USUARIO Y CURSO QUE ESTAMOS ANALIZANDO
        
        'COMPROBAMOS SI HUBO MÁS DE 1 FILA DE INFORMACIÓN DEL CURSO PARA LA PERSONA
        If Not (IsEmpty(filteredFirstRow) And IsEmpty(filteredSecondRow)) Then
        
            'COMPROBAMOS SI SE DA LA CASUÍSTICA DE QUE LA PRIMERA FILA QUE HAY ES REGISTERED Y LA SEGUNDA COMPLETED
            If filteredFirstRowStatus = "Registered" And filteredSecondRowStatus = "Completed" Then
                
                'COJEMOS LA FECHA DE TRAINING STARTING DATE DE LA FILA CON  STATUS DE REGISTERED
                filteredFirstRowDate = Split(filteredFirstRow(1, trainingStartingDateNumberColumn), " ")(0) 'FORMATEAMOS LA FECHA PORQUE EN LA CELDA VIENE CON LA HORA TAMBIÉN Y SOLO QUEREMOS DIAS/MES/AÑO
                
                'COJEMOS LA FECHA DE END TRAINING PARA LA FILA CON STATUS DE COMPLETADO Y LE QUITAMOS LA HORA QUE VIENE CON LA FECHA EN LA CELDA
                filteredSecondRowDate = Split(filteredSecondRow(1, trainingEndDateNumberColumn), " ")(0)
                 
                    'COMPROBAMOS LA FECHA DE CADUCIDAD DEL CURSO
                    If IsDate(filteredSecondRowDate) Then
                        Select Case courseHeader
                            Case "PREV., EXTINCION INCENDIOS, RECICLAJE - Completion date":
                                expYears = 1
                            Case "CURSO LUCHA CONTRAINCENDIOS. MÓDULO 1 - Status", "CURSO LUCHA CONTRAINCENDIOS. MODULO2 - Completion date", _
                                 "CURSO LUCHA CONTRAINCENDIOS MODULO3 - Completion date":
                                expYears = -1
                            Case Else:
                                expYears = 5
                        End Select
                        
                        If expYears > 0 Then
                            expireDate = DateAdd("yyyy", expYears, CDate(filteredSecondRowDate))
                        Else
                            expireDate = DateAdd("yyyy", 5, CDate(filteredSecondRowDate))
                        End If
                    End If
                    
                    'SI EFECTIVAMENTE ESTÁ CADUCADO, LE AÑADIMOS COMO STATUS REGISTERED Y SU FECHA DE REGISTRO
                    If DateDiff("d", expireDate, Date) > 0 Then
                        newStatus = filteredFirstRowStatus
                        newDate = filteredFirstRowDate
                    'SI NO ESTÁ CADUCADO, PONEMOS COMO STATUS QUE ESTÁ REGISTRADO PERO QUE NO ES NECESARIO
                    Else
                        newStatus = "Registered / No necessary"
                        newDate = filteredFirstRowDate
                    End If
                    
            'SI LA PRIMERA FILA NO TIENE DE STATUS REGISTERED Y LA SEGUNDA COMPLETED, EN CUALQUIERA DE LOS CASOS,
            'COGEMOS LOS DATOS DE LA PRIMERA FILA QUE APARECE
            Else
                filteredFirstRowDate = Split(filteredFirstRow(1, trainingStartingDateNumberColumn), " ")(0)
                newStatus = filteredFirstRowStatus
                'LA FECHA QUE SE QUIERE MOSTRAR ES CUANDO SE TERMINÓ EL CURSO,
                'COMPROBAMOS EN LA COLUMNA "END TRAINING"
                If filteredFirstRowDate <> "" Then
                    newDate = filteredFirstRowDate
                'SI NO HAY FECHA EN LA COLUMNA "END TRAINING", SE COLOCA LA FECHA DE SU ÚLTIMO STATUS
                Else
                    newDate = Split(filteredFirstRow(1, trainingStartingDateNumberColumn), " ")(0)
                End If
            End If
        'SI NO HUBO MÁS DE 2 FILAS DE INFORMACIÓN COMPROBAMOS SI HUBO AUNQUE SEA 1
        ElseIf Not IsEmpty(filteredFirstRow) Then
                newStatus = filteredFirstRowStatus
                'LA FECHA QUE SE QUIERE MOSTRAR ES CUANDO SE TERMINÓ EL CURSO,
                'COMPROBAMOS EN LA COLUMNA "END TRAINING"
                If filteredFirstRowDate <> "" Then
                    newDate = filteredFirstRowDate
                'SI NO HAY FECHA EN LA COLUMNA "END TRAINING", SE COLOCA LA FECHA DE SU ÚLTIMO STATUS
                Else
                    newDate = Split(filteredFirstRow(1, trainingStartingDateNumberColumn), " ")(0)
                End If
        'SI NO HAY FILAS CON INFORMACIÓN DEL CURSO PARA ESA PERSONA, PONEMOS STATUS PENDING Y FECHA VACIA PARA EL INFORME FINAL
        Else
            newStatus = "Pending"
            newDate = ""
        End If
        
        checkAllLearningForMissingCourse = Array(newStatus, newDate)
        
    End With
    
    On Error GoTo 0
    
End Function

Function getVisibleRowsUsingSpecialCells(ByVal ws As Worksheet) As Variant
    Dim visibleRange As Range
    Dim area, rng As Range
    Dim allVisibleRanges As Range

    ' Filter visible cells and assign them to a range variable
    On Error Resume Next ' In case no cells are visible
    Set rng = ws.UsedRange
    Set visibleRange = rng.Offset(1, 0).Resize(rng.Rows.Count - 1, rng.Columns.Count).SpecialCells(xlCellTypeVisible)
    On Error GoTo 0

    ' Check if visibleRange is not Nothing
    If Not visibleRange Is Nothing Then
        ' Loop through each area in the visibleRange
        For Each area In visibleRange.Areas
            If allVisibleRanges Is Nothing Then
                ' If allVisibleRanges is empty, set it to the current area
                Set allVisibleRanges = area
            Else
                ' If allVisibleRanges is not empty, union it with the current area
                Set allVisibleRanges = Union(allVisibleRanges, area)
            End If
        Next area
    End If
    
    getVisibleRowsUsingSpecialCells = allVisibleRanges.Value
End Function

