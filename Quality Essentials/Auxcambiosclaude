' Método que crea agupaciones de columnas
Private Sub groupColumns(ByVal ws As Worksheet, ByVal columnGroups As Dictionary)
    Dim i, n, lastRow
    Dim colorArray
    
    colorArray = Array(RGB(218, 150, 148), RGB(196, 215, 155), RGB(149, 179, 215), RGB(147, 172, 78), _
                        RGB(196, 189, 151), RGB(217, 217, 217), RGB(252, 213, 180))
    
    lastRow = ws.Cells(Rows.Count, 1).End(xlUp).row
    
    ws.Range(ws.Cells(2, 6), ws.Cells(lastRow, 6)).BorderAround LineStyle:=xlContinuous, Weight:=xlThick
    
    n = 0
    For i = 0 To UBound(columnGroups.Keys)
        With ws.Cells(1, columnGroups.Items(i)(0))
            .Value = columnGroups.Keys(i)
            .Font.Size = 13
            .Font.Bold = True
            .WrapText = True
        End With
        
        ws.Columns(columnGroups.Items(i)(0)).ColumnWidth = 23

        
        With ws.Range(ws.Cells(2, columnGroups.Items(i)(0)), ws.Cells(2, columnGroups.Items(i)(1)))
            .Borders.LineStyle = xlContinuous
            .Borders.Color = RGB(0, 0, 0)
            .Borders.Weight = xlMedium
            .Font.Bold = True
        End With
        ws.Range(ws.Cells(1, columnGroups.Items(i)(0)), ws.Cells(2, columnGroups.Items(i)(1))).Interior.Color = colorArray(n)
        ws.Range(ws.Cells(1, columnGroups.Items(i)(0)), ws.Cells(1, columnGroups.Items(i)(1) - 1)).Merge
        ws.Range(ws.Cells(1, columnGroups.Items(i)(0)), ws.Cells(lastRow, columnGroups.Items(i)(1))).BorderAround _
                                                                                                    LineStyle:=xlContinuous, Weight:=xlThick
        If n = UBound(colorArray) Then
            n = 0
        Else
            n = n + 1
        End If
    Next i
End Sub

