' Método que colorea de color rojo las fechas de los cursos caducados y añade "(Caducado)" al final del estado del curso.
Private Sub colorExpiredDates()
    Dim statusCell, statusCol, lastRow, lastColumn, expYears
    Dim expireDate As Date
    Dim userID As String
    Dim curso As String
    
    expYears = 5
    
    For Each ws In Worksheets
        Set statusCell = ws.Rows(2).Find(What:="Curriculum Status", LookIn:=xlValues, LookAt:=xlWhole)
        If statusCell Is Nothing Then
            statusCol = 1
        Else
            statusCol = statusCell.column
        End If
        lastRow = ws.Cells(ws.Rows.Count, 1).End(xlUp).row
        lastColumn = ws.Cells(2, ws.Columns.Count).End(xlToLeft).column
        
        For i = 3 To lastRow
        
            userID = ws.Cells(i, 3).Value
            
            'If para encontrar a una o más personas concretas o todas, buscar la variable userIDsForTesting para ir a donde se añade o se quita a la gente de esta variable
            If userIDsForTesting.Exists(userID) Or userIDsForTesting.Count = 0 Then
                For j = statusCol + 2 To lastColumn Step 2
                    curso = ws.Cells(2, j).Value
                    Select Case ws.Cells(2, j).Value    ' Select Case para excepciones de años de caducidad ("-1" -> No caduca)
                        Case "PREV., EXTINCION INCENDIOS, RECICLAJE - Completion date":
                            expYears = 1
                        Case "CURSO LUCHA CONTRAINCENDIOS. MÓDULO 1 - Status", "CURSO LUCHA CONTRAINCENDIOS. MODULO2 - Completion date", _
                             "CURSO LUCHA CONTRAINCENDIOS MODULO3 - Completion date":
                            expYears = -1
                        Case Else:
                            expYears = 5
                    End Select
                    
                    If expYears > 0 Then
                        With ws.Cells(i, j)
                            If .Value <> "" And IsDate(.Value) Then
                                expireDate = DateAdd("yyyy", expYears, CDate(.Value))
                                If DateDiff("d", expireDate, Date) > 0 Then
                                    ws.Cells(i, j).Font.Color = RGB(255, 0, 0)
                                    ws.Cells(i, j).Interior.Color = RGB(255, 192, 0)
                                    ws.Cells(i, j - 1).Value = ws.Cells(i, j - 1).Value & " (Caducado)"
                                    ws.Cells(i, j - 1).Interior.Color = RGB(255, 192, 0) 'Naranja
                                    ws.Cells(i, j - 1).Font.Color = RGB(255, 0, 0)
                                End If
                            End If
                        End With
                    End If
                Next j
            'End If de userIDsForTesting.Exists(userID) Or userIDsForTesting.Count = 0
            End If
        Next i
    Next ws
