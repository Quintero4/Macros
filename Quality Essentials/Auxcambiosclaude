' Método que aplica autoajuste a las columnas del documento con una anchura minima definida
Public Sub autofitColumns()
    Dim lastRow, lastColumn As Integer
    Dim ws As Worksheet
    Dim col, minWidth, headerRow
    
    minWidth = 12
    headerRow = 2
    
    For Each ws In Worksheets
        lastRow = ws.Cells(ws.Rows.Count, 1).End(xlUp).row
        lastColumn = ws.Cells(headerRow, ws.Columns.Count).End(xlToLeft).column
        With ws.Range(ws.Cells(3, 1), ws.Cells(lastRow, lastColumn))
            .WrapText = False
            .Columns.AutoFit
            For Each col In .Columns
                If col.ColumnWidth < minWidth Then
                    col.ColumnWidth = minWidth
                    .Rows(headerRow).AutoFit
                End If
            Next col
        End With
    Next ws
    
    Sheets(1).Activate
End Sub

