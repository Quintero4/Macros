Private Function sortStringArray(ByVal stringArray) As Variant
    Dim i As Long, j As Long
    Dim temp As String
    
    ' Bubble sort algorithm
    For i = LBound(stringArray) To UBound(stringArray) - 1
        For j = i + 1 To UBound(stringArray)
            If stringArray(i) > stringArray(j) Then
                ' Swap elements if out of order
                temp = stringArray(i)
                stringArray(i) = stringArray(j)
                stringArray(j) = temp
            End If
        Next j
    Next i
    
    sortStringArray = stringArray
End Function

