' Método que separa los datos en una serie de hojas, una para cada curriculum definido.
Private Sub splitCurriculums(ByVal curriculums As Dictionary)
    Dim i, firstTableRow, lastTableRow, lastColumn As Integer
    Dim newSheet As Worksheet
    
    For Each curriculum In curriculums.Keys
        Sheets(1).Activate
        'Si has llegado aquí por que te ha dado error, comprueba que no hayan abiertos libros que abre la macro de antes de ejecutar
        firstTableRow = Columns(1).Find(What:=curriculum, LookIn:=xlValues, LookAt:=xlWhole).row + 1
        lastTableRow = Cells(firstTableRow, 2).End(xlDown).row
        lastColumn = Cells(firstTableRow, Columns.Count).End(xlToLeft).column
        
        Sheets(1).Range(Cells(firstTableRow, 1), Cells(lastTableRow, lastColumn)).Copy
        
        Set newSheet = ActiveWorkbook.Worksheets.Add(After:=Sheets(Sheets.Count))
        newSheet.Range(Cells(2, 1), Cells(lastTableRow - firstTableRow + 1, lastColumn)).PasteSpecial xlPasteAll
        
        newSheet.Range(Cells(2, 1), Cells(2, lastColumn)).AutoFilter
        
        newSheet.name = curriculums(curriculum)
        newSheet.Columns.AutoFit
        newSheet.Cells(1, 1).Value = curriculum
        newSheet.Cells(2, 1).Select
        
        ' Eliminar filas donde la columna D no comienza por "TAOAA", "TAOAT" o "TAOAF"
        If newSheet.name = "Reporte BC" Then
        Dim row As Long
        For row = newSheet.Cells(newSheet.Rows.Count, 4).End(xlUp).row To 3 Step -1
            If Not (Left(newSheet.Cells(row, 4).Value, 5) = "TAOAA" Or Left(newSheet.Cells(row, 4).Value, 5) = "TAOAT" Or Left(newSheet.Cells(row, 4).Value, 5) = "TAOAF") Then
                newSheet.Rows(row).Delete
            End If
        Next row
        End If
        
    Next curriculum
    
    ActiveWorkbook.Sheets(1).Delete
    ActiveWorkbook.Sheets(1).Activate
End Sub

